# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://ong_user:ong_dev_password@localhost:5432/ong_agentic_canvas
DATABASE_URL_SYNC=postgresql+psycopg2://ong_user:ong_dev_password@localhost:5432/ong_agentic_canvas

# LLM Provider
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your-google-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Vector Store (ChromaDB)
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=ong_brand_rules

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Guardrails
MAX_REPAIR_ATTEMPTS=3
GUARDRAIL_PASS_THRESHOLD=75.0

# Retry Configuration
MAX_AGENT_RETRIES=3
AGENT_RETRY_DELAY_SECONDS=1
